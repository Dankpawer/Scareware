
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Scareware Lab | Cybersecurity</title>

<style>
:root {
    --bg: #080d18;
    --panel: #111a2b;
    --border: #26364e;
    --blue: #43b5ff;
    --text: #e8eef8;
    --muted: #a7b5ca;
    --orange: #ffb454;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Arial, sans-serif;
    line-height: 1.6;
}

header {
    padding: 42px 20px;
    text-align: center;
    background: #0d1728;
    border-bottom: 1px solid var(--border);
}

.tag {
    color: var(--blue);
    font-size: 12px;
    letter-spacing: 3px;
}

h1 {
    font-size: clamp(28px, 5vw, 44px);
    margin: 12px 0;
}

header p, .muted {
    color: var(--muted);
}

main {
    max-width: 950px;
    width: 92%;
    margin: 30px auto;
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    margin-bottom: 18px;
}

.card h2 {
    color: var(--blue);
    font-size: 20px;
    margin-top: 0;
}

button {
    background: #1479c9;
    color: white;
    border: 1px solid #3598e5;
    padding: 11px 16px;
    border-radius: 7px;
    font-size: 14px;
    cursor: pointer;
}

button:hover {
    background: #0963a9;
}

button:focus-visible,
input:focus-visible {
    outline: 3px solid white;
    outline-offset: 3px;
}

button:disabled {
    opacity: .6;
    cursor: not-allowed;
}

.secondary {
    background: #202e43;
    border-color: #425571;
}

.warning {
    border: 1px solid #b8782c;
    background: #302416;
    border-radius: 9px;
    padding: 16px;
    margin-top: 18px;
}

.warning h3 {
    color: var(--orange);
    margin-top: 0;
}

[hidden] {
    display: none !important;
}

.status {
    color: var(--muted);
    overflow-wrap: anywhere;
}

li {
    margin-bottom: 9px;
}

.check {
    display: flex;
    gap: 10px;
    margin: 14px 0;
    align-items: flex-start;
}

.check input {
    margin-top: 6px;
    accent-color: var(--blue);
}

.progress {
    height: 7px;
    background: #26364e;
    border-radius: 10px;
    overflow: hidden;
    margin: 12px 0;
}

#progressBar {
    height: 100%;
    width: 0%;
    background: var(--blue);
    transition: width .2s;
}

footer {
    text-align: center;
    padding: 25px;
    color: var(--muted);
    border-top: 1px solid var(--border);
    font-size: 13px;
}

@media (max-width: 650px) {
    .grid {
        grid-template-columns: 1fr;
    }

    header {
        padding: 30px 16px;
    }
}
</style>
</head>

<body>
<header>
    <div class="tag">CYBERSECURITY LAB / 001</div>
    <h1>Scareware Lab</h1>
    <p>Aprenda a reconhecer alertas falsos e proteger seu navegador.</p>
</header>

<main>
    <section class="card">
        <h2>01 / Laboratório</h2>
        <p>
            Este ambiente demonstra técnicas de scareware
            sem detectar ameaças, coletar dados ou instalar programas.
        </p>
        <button id="start">Iniciar simulação</button>

        <div id="fakeAlert" class="warning" role="status" hidden>
            <h3>ALERTA FICTÍCIO DE SEGURANÇA</h3>
            <p>
                Um site suspeito poderia afirmar que seu dispositivo
                está infectado para provocar medo.
            </p>
            <p><strong>Este alerta é uma simulação.</strong>
            Nenhuma ameaça foi detectada.</p>
            <button id="closeAlert" class="secondary">
                Fechar alerta
            </button>
        </div>
    </section>

    <div class="grid">
        <section class="card">
            <h2>02 / Teste de pop-up</h2>
            <p>
                Solicite a abertura de uma janela de teste.
                O navegador pode permitir ou bloquear a solicitação.
            </p>
            <button id="testPopup">Testar pop-up</button>
            <p id="popupStatus" class="status" role="status"
               aria-live="polite">
                Aguardando teste.
            </p>
        </section>

        <section class="card">
            <h2>03 / Sinais de scareware</h2>
            <ul>
                <li>Urgência artificial e mensagens alarmantes.</li>
                <li>Ameaças sem evidências verificáveis.</li>
                <li>Pedidos de pagamento para remover supostos vírus.</li>
                <li>Solicitações para baixar programas desconhecidos.</li>
            </ul>
        </section>
    </div>

    <section class="card">
        <h2>04 / Plano de contenção</h2>
        <p class="muted">
            Marque cada medida após estudar ou executar a ação.
        </p>

        <div class="progress">
            <div id="progressBar"></div>
        </div>
        <p id="progressText" class="status" aria-live="polite">
            0 de 5 medidas concluídas.
        </p>

        <label class="check">
            <input type="checkbox">
            <span>Não clicar em links ou botões suspeitos.</span>
        </label>

        <label class="check">
            <input type="checkbox">
            <span>Fechar a página que apresenta alertas suspeitos.</span>
        </label>

        <label class="check">
            <input type="checkbox">
            <span>Revisar permissões de notificações e pop-ups.</span>
        </label>

        <label class="check">
            <input type="checkbox">
            <span>Revisar extensões desconhecidas do navegador.</span>
        </label>

        <label class="check">
            <input type="checkbox">
            <span>Usar uma ferramenta confiável para verificar
            possíveis ameaças, se necessário.</span>
        </label>
    </section>

    <section class="card">
        <h2>05 / Configuração do navegador</h2>
        <p>
            Compare as configurações de pop-ups do Edge e do Chrome.
            Mantenha os bloqueios ativos para sites desconhecidos.
        </p>

        <p>
            <strong>Microsoft Edge:</strong><br>
            Configurações → Cookies e permissões de site →
            Pop-ups e redirecionamentos.
        </p>

        <p>
            <strong>Google Chrome:</strong><br>
            Configurações → Privacidade e segurança →
            Configurações do site → Pop-ups e redirecionamentos.
        </p>
    </section>

    <section class="card">
        <h2>06 / Conclusão do laboratório</h2>
        <p>
            Um alerta mostrado por uma página não comprova que
            o computador está infectado. Evite agir sob pressão
            e procure informações em ferramentas de segurança confiáveis.
        </p>
        <button id="reset" class="secondary">
            Reiniciar simulação
        </button>
        <p id="resetStatus" class="status" role="status"
           aria-live="polite"></p>
    </section>
</main>

<footer>
    SC​​AREWARE LAB · PROJETO EDUCACIONAL · SEM MALWARE REAL
</footer>

<script>
const start = document.getElementById("start");
const fakeAlert = document.getElementById("fakeAlert");
const closeAlert = document.getElementById("closeAlert");
const testPopup = document.getElementById("testPopup");
const popupStatus = document.getElementById("popupStatus");
const reset = document.getElementById("reset");

start.addEventListener("click", () => {
    fakeAlert.hidden = false;
    start.disabled = true;
    start.textContent = "Simulação iniciada";
});

closeAlert.addEventListener("click", () => {
    fakeAlert.hidden = true;
    start.disabled = false;
    start.textContent = "Iniciar simulação";
});

testPopup.addEventListener("click", () => {
    const win = window.open(
        "about:blank",
        "_blank",
        "width=400,height=250"
    );

    if (!win) {
        popupStatus.textContent =
            "A janela foi bloqueada pelo navegador.";
        return;
    }

    const title = win.document.createElement("h2");
    title.textContent = "Teste de pop-up";

    const message = win.document.createElement("p");
    message.textContent =
        "Janela de teste educacional. Nenhuma ameaça real.";

    win.document.body.style.cssText =
        "font-family:Arial,sans-serif;padding:20px;background:#f3f6fa;color:#172033";

    win.document.body.replaceChildren(title, message);
    popupStatus.textContent =
        "Janela aberta. Feche-a manualmente após observar o resultado.";
});

const checks = [...document.querySelectorAll(
    '.check input[type="checkbox"]'
)];
const progressBar = document.getElementById("progressBar");
const progressText = document.getElementById("progressText");

function updateProgress() {
    const completed = checks.filter(item => item.checked).length;
    const percent = completed / checks.length * 100;

    progressBar.style.width = percent + "%";
    progressText.textContent =
        completed + " de " + checks.length + " medidas concluídas.";
}

checks.forEach(item => {
    item.addEventListener("change", updateProgress);
});

reset.addEventListener("click", () => {
    fakeAlert.hidden = true;
    start.disabled = false;
    start.textContent = "Iniciar simulação";

    checks.forEach(item => {
        item.checked = false;
    });

    updateProgress();
    popupStatus.textContent = "Aguardando teste.";
    document.getElementById("resetStatus").textContent =
        "Simulação reiniciada.";
});

updateProgress();
</script>
</body>
</html>
